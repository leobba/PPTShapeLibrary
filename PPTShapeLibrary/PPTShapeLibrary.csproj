  <!--
    关键修复：Office targets 在 PrepareForRun 阶段「无条件」把加载项注册为
        <输出目录>\PPTShapeLibrary.vsto|vstolocal
    （其 RegisterOfficeAddin 只判断 VSTO_ProjectType，不看 RegisterForVSTO）。
    于是命令行打包（/t:Publish、/t:Rebuild）会把这种"开发式注册"写进注册表，
    与用户通过安装器/ClickOnce 安装的正式版互相覆盖，并导致再次安装时抛
    AddInAlreadyInstalledException（"已安装另一版本的自定义项，不能从该位置升级"）。
    下面在 Office targets 导入之后重定义同名 target（后定义者生效）：
    Release 不注册，Debug 保持原行为（F5 调试需要注册）。
  -->
  <Target Name="RegisterOfficeAddin" Condition="'$(VSTO_ProjectType)' == 'Application' and '$(Configuration)' != 'Release' and '$(VstoSkipRegistration)' != 'true'">
    <SetOffice2007AddInRegistration
        Url="$(AbsolutePathToTheDeploymentManifest)"
        AddInName="$(TargetName)"
        OfficeApplication="$(OfficeApplication)"
        FriendlyName="$(FriendlyName)"
        Description="$(OfficeApplicationDescription)"
        LoadBehavior="$(LoadBehavior)" />
  </Target>
  <!--
    同样关键的对称修复：Office targets 的 VSTOClean（Clean/Rebuild 都会跑）依赖 UnregisterOfficeAddin，
    而它**不看 RegisterForVSTO**，会无条件调用 SetOffice2007AddInRegistration(Unregister=true)。
    只挡住"注册"不挡"注销"的后果是：一次 `msbuild /t:Rebuild /p:Configuration=Release` 就会把
    用户已装好的加载项注册**删掉**（版本无关键消失），此后 PowerPoint 功能区不再出现「素材库」——
    这正是长期被当成"不明原因消失"的那个现象（实测：Release Rebuild 后 版本无关键 由 True 变 False，
    Debug Rebuild 因还会重新注册所以看起来"恢复"了）。
    Release 下把注销也置空；Debug 保留原行为（F5 调试需要 VS 管理注册）。
  -->
  <Target Name="UnregisterOfficeAddin" Condition="'$(VSTO_ProjectType)' == 'Application' and '$(Configuration)' != 'Release' and '$(VstoSkipRegistration)' != 'true'">
    <SetOffice2007AddInRegistration
        Url="$(AbsolutePathToTheDeploymentManifest)"
        AddInName="$(TargetName)"
        OfficeApplication="$(OfficeApplication)"
        FriendlyName="$(FriendlyName)"
        Description="$(OfficeApplicationDescription)"
        LoadBehavior="$(LoadBehavior)"
        Unregister="true" />
  </Target>
